# MCP Session Memory Dashboard - Environment Variables
# Copy this file to .env and customize for your environment

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the web dashboard server
# Default: 3001
DASHBOARD_PORT=3001

# Host address to bind the server to
# Default: localhost (use 0.0.0.0 for all interfaces)
DASHBOARD_HOST=localhost

# =============================================================================
# Database Configuration
# =============================================================================

# Path to the SQLite database file
# Default: ~/.opencode/sessions/session.db
# Use absolute path or tilde (~) for home directory
SESSION_DB_PATH=~/.opencode/sessions/session.db

# =============================================================================
# Security & Authentication
# =============================================================================

# Optional bearer token for API authentication
# If set, all API endpoints (except /api/health/*) will require this token
# Pass as: Authorization: Bearer <token>
# Leave empty to disable authentication (not recommended for production)
MCP_DASHBOARD_TOKEN=

# Example: Generate a secure token with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_DASHBOARD_TOKEN=your-secret-token-here

# =============================================================================
# CORS Configuration
# =============================================================================

# Enable Cross-Origin Resource Sharing (CORS)
# Set to "false" if you don't need cross-origin requests
# Default: true
ENABLE_CORS=true

# =============================================================================
# Logging & Debugging
# =============================================================================

# Log level for server output
# Options: error, warn, info, debug, trace
# Default: info
LOG_LEVEL=info

# =============================================================================
# Development Features
# =============================================================================

# Automatically open browser when dashboard starts
# Default: false
OPEN_BROWSER=false

# =============================================================================
# Production Deployment
# =============================================================================

# Example production configuration:
# DASHBOARD_PORT=8080
# DASHBOARD_HOST=0.0.0.0
# MCP_DASHBOARD_TOKEN=<secure-random-token>
# ENABLE_CORS=false
# LOG_LEVEL=warn
# OPEN_BROWSER=false

# =============================================================================
# Docker Configuration
# =============================================================================

# When running in Docker, use these settings:
# DASHBOARD_HOST=0.0.0.0
# SESSION_DB_PATH=/data/session.db
# Mount volume: -v ~/.opencode/sessions:/data

# =============================================================================
# Systemd Service Configuration
# =============================================================================

# For systemd service deployments:
# - Store this file at: /etc/mcp-session-memory/.env
# - Set EnvironmentFile=/etc/mcp-session-memory/.env in service file
# - Use absolute paths (no tilde ~)
# SESSION_DB_PATH=/home/user/.opencode/sessions/session.db
