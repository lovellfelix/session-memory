{
  "name": "@lovellfelix/mcp-session-memory",
  "version": "2.0.0",
  "description": "MCP server for persistent session context, user preferences, and cross-workflow learning",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-session-memory": "dist/index.js",
    "smem": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "cleancss -o public/styles.min.css public/styles.css",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "dashboard": "node start-dashboard.js",
    "dashboard:start": "./scripts/dashboard start",
    "dashboard:stop": "./scripts/dashboard stop",
    "dashboard:restart": "./scripts/dashboard restart",
    "dashboard:status": "./scripts/dashboard status",
    "dashboard:logs": "./scripts/dashboard logs",
    "dashboard:health": "./scripts/dashboard health",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "export:tokens": "node scripts/export-design-tokens.mjs",
    "test:a11y": "node scripts/test-accessibility.mjs"
  },
  "keywords": [
    "mcp",
    "session-memory",
    "opencode",
    "ai-assistant",
    "cross-workflow-learning",
    "semantic-search"
  ],
  "author": "Lovell Felix",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^9.1.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "dotenv": "^16.3.1",
    "fastify": "^5.8.5",
    "sql.js": "^1.10.3"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.9",
    "axe-core": "^4.11.0",
    "clean-css-cli": "^5.6.3",
    "jest": "^29.7.0",
    "pa11y": "^9.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
