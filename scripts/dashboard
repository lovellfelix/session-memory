#!/usr/bin/env bash

# Dashboard Management Script
# Provides easy commands for starting, stopping, and managing the MCP Session Memory Dashboard

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default configuration
DEFAULT_PORT=3001
DEFAULT_HOST="localhost"
DASHBOARD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PID_FILE="${DASHBOARD_DIR}/.dashboard.pid"
LOG_FILE="${DASHBOARD_DIR}/.dashboard.log"

# Load environment variables from .env if exists
if [ -f "${DASHBOARD_DIR}/.env" ]; then
    # shellcheck source=/dev/null
    source "${DASHBOARD_DIR}/.env"
fi

# Get configuration
PORT="${DASHBOARD_PORT:-${PORT:-$DEFAULT_PORT}}"
HOST="${DASHBOARD_HOST:-${HOST:-$DEFAULT_HOST}}"
DASHBOARD_URL="http://${HOST}:${PORT}"

# Print colored message
log() {
    local color=$1
    shift
    echo -e "${color}$*${NC}"
}

# Check if dashboard is running
is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        else
            # PID file exists but process is dead
            rm -f "$PID_FILE"
            return 1
        fi
    fi
    return 1
}

# Get dashboard PID
get_pid() {
    if [ -f "$PID_FILE" ]; then
        cat "$PID_FILE"
    else
        echo ""
    fi
}

# Start dashboard
cmd_start() {
    log "$BLUE" "🚀 Starting MCP Session Memory Dashboard..."
    
    if is_running; then
        log "$YELLOW" "⚠️  Dashboard is already running (PID: $(get_pid))"
        log "$BLUE" "   URL: ${DASHBOARD_URL}"
        return 0
    fi
    
    # Build if dist doesn't exist
    if [ ! -d "${DASHBOARD_DIR}/dist" ]; then
        log "$BLUE" "📦 Building dashboard..."
        cd "$DASHBOARD_DIR"
        npm run build > /dev/null 2>&1 || {
            log "$RED" "❌ Build failed. Run 'npm run build' to see errors."
            exit 1
        }
    fi
    
    # Start dashboard in background
    cd "$DASHBOARD_DIR"
    nohup node start-dashboard.js > "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"
    
    # Wait for server to start
    log "$BLUE" "⏳ Waiting for server to start..."
    local max_attempts=30
    local attempt=0
    
    while [ $attempt -lt $max_attempts ]; do
        if curl -s "${DASHBOARD_URL}/api/health/live" > /dev/null 2>&1; then
            log "$GREEN" "✅ Dashboard started successfully!"
            log "$GREEN" "   PID: ${pid}"
            log "$GREEN" "   URL: ${DASHBOARD_URL}"
            log "$BLUE" "   Logs: ${LOG_FILE}"
            return 0
        fi
        sleep 0.5
        ((attempt++))
    done
    
    log "$RED" "❌ Dashboard failed to start within 15 seconds"
    log "$YELLOW" "   Check logs: tail -f ${LOG_FILE}"
    rm -f "$PID_FILE"
    exit 1
}

# Stop dashboard
cmd_stop() {
    log "$BLUE" "🛑 Stopping dashboard..."
    
    if ! is_running; then
        log "$YELLOW" "⚠️  Dashboard is not running"
        return 0
    fi
    
    local pid
    pid=$(get_pid)
    
    # Send SIGTERM for graceful shutdown
    log "$BLUE" "   Sending SIGTERM to PID ${pid}..."
    kill -TERM "$pid" 2>/dev/null || true
    
    # Wait for graceful shutdown
    local max_wait=10
    local waited=0
    
    while kill -0 "$pid" 2>/dev/null && [ $waited -lt $max_wait ]; do
        sleep 0.5
        ((waited++))
    done
    
    # Force kill if still running
    if kill -0 "$pid" 2>/dev/null; then
        log "$YELLOW" "   Forcing shutdown..."
        kill -KILL "$pid" 2>/dev/null || true
        sleep 0.5
    fi
    
    rm -f "$PID_FILE"
    log "$GREEN" "✅ Dashboard stopped"
}

# Restart dashboard
cmd_restart() {
    log "$BLUE" "🔄 Restarting dashboard..."
    cmd_stop
    sleep 1
    cmd_start
}

# Show dashboard status
cmd_status() {
    log "$BLUE" "📊 Dashboard Status"
    log "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if is_running; then
        local pid
        pid=$(get_pid)
        log "$GREEN" "Status:    Running ✓"
        log "$BLUE" "PID:       ${pid}"
        log "$BLUE" "URL:       ${DASHBOARD_URL}"
        log "$BLUE" "Logs:      ${LOG_FILE}"
        
        # Try to get health info
        if command -v curl >/dev/null 2>&1; then
            local health
            health=$(curl -s "${DASHBOARD_URL}/api/health" 2>/dev/null || echo '{}')
            
            if [ "$health" != '{}' ]; then
                log "$BLUE" ""
                log "$BLUE" "Health Check:"
                
                # Extract basic info using simple parsing
                if echo "$health" | grep -q '"status":"healthy"'; then
                    log "$GREEN" "  • Status: Healthy ✓"
                else
                    log "$YELLOW" "  • Status: Unknown"
                fi
                
                # Show uptime if available
                local uptime
                uptime=$(echo "$health" | grep -o '"uptime":[0-9.]*' | cut -d: -f2)
                if [ -n "$uptime" ]; then
                    local uptime_formatted
                    uptime_formatted=$(printf "%.0f" "$uptime")
                    log "$BLUE" "  • Uptime: ${uptime_formatted}s"
                fi
            fi
        fi
    else
        log "$YELLOW" "Status:    Not running"
        log "$BLUE" "URL:       ${DASHBOARD_URL} (when running)"
    fi
    
    log "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

# View logs
cmd_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        log "$YELLOW" "⚠️  No log file found at ${LOG_FILE}"
        return 1
    fi
    
    log "$BLUE" "📄 Dashboard Logs (${LOG_FILE})"
    log "$BLUE" "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    
    if [ "${1:-}" = "follow" ] || [ "${1:-}" = "-f" ]; then
        tail -f "$LOG_FILE"
    else
        tail -n 50 "$LOG_FILE"
    fi
}

# Open dashboard in browser
cmd_open() {
    if ! is_running; then
        log "$YELLOW" "⚠️  Dashboard is not running"
        log "$BLUE" "   Start it with: $0 start"
        return 1
    fi
    
    log "$BLUE" "🌐 Opening dashboard in browser..."
    
    case "$(uname -s)" in
        Darwin)
            open "$DASHBOARD_URL"
            ;;
        Linux)
            xdg-open "$DASHBOARD_URL" 2>/dev/null || log "$YELLOW" "   Could not open browser"
            ;;
        *)
            log "$YELLOW" "   Platform not supported for auto-open"
            log "$BLUE" "   Visit: ${DASHBOARD_URL}"
            ;;
    esac
}

# Health check
cmd_health() {
    if ! is_running; then
        log "$RED" "❌ Dashboard is not running"
        return 1
    fi
    
    if ! command -v curl >/dev/null 2>&1; then
        log "$YELLOW" "⚠️  curl not found, cannot perform health check"
        return 1
    fi
    
    log "$BLUE" "🔍 Performing health check..."
    
    local response
    response=$(curl -s -w "\n%{http_code}" "${DASHBOARD_URL}/api/health" 2>/dev/null || echo "000")
    
    local http_code
    http_code=$(echo "$response" | tail -n1)
    local body
    body=$(echo "$response" | sed '$d')
    
    if [ "$http_code" = "200" ]; then
        log "$GREEN" "✅ Dashboard is healthy"
        echo "$body" | python3 -m json.tool 2>/dev/null || echo "$body"
    else
        log "$RED" "❌ Health check failed (HTTP ${http_code})"
        echo "$body"
        return 1
    fi
}

# Show help
cmd_help() {
    cat <<EOF
${BLUE}MCP Session Memory Dashboard Management${NC}

${GREEN}USAGE:${NC}
    $0 <command> [options]

${GREEN}COMMANDS:${NC}
    start       Start the dashboard server
    stop        Stop the dashboard server
    restart     Restart the dashboard server
    status      Show dashboard status
    logs        View dashboard logs
    logs -f     Follow dashboard logs (live)
    open        Open dashboard in browser
    health      Perform health check
    help        Show this help message

${GREEN}ENVIRONMENT VARIABLES:${NC}
    DASHBOARD_PORT          Server port (default: 3001)
    DASHBOARD_HOST          Server host (default: localhost)
    MCP_DASHBOARD_TOKEN     API authentication token (optional)
    SESSION_DB_PATH         Database file path
    OPEN_BROWSER           Auto-open browser on start (true/false)

${GREEN}EXAMPLES:${NC}
    $0 start                    # Start dashboard
    $0 status                   # Check status
    $0 logs -f                  # Follow logs
    DASHBOARD_PORT=3002 $0 start    # Start on port 3002

${GREEN}FILES:${NC}
    PID File:  ${PID_FILE}
    Log File:  ${LOG_FILE}
    Config:    ${DASHBOARD_DIR}/.env (optional)

${GREEN}DOCUMENTATION:${NC}
    https://github.com/lovellfelix/dotfiles/tree/main/opencode/.config/opencode/mcp-servers/session-memory
EOF
}

# Main command dispatcher
main() {
    local command="${1:-help}"
    
    case "$command" in
        start)
            cmd_start
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            cmd_restart
            ;;
        status)
            cmd_status
            ;;
        logs)
            cmd_logs "${2:-}"
            ;;
        open)
            cmd_open
            ;;
        health)
            cmd_health
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            log "$RED" "❌ Unknown command: ${command}"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

# Run main
main "$@"
